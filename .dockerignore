# Keep the build context lean but DO NOT deny-all: the Vite build needs
# excalidraw-app/, packages/, public/, scripts/, tsconfig.json, .env.* and
# every workspace package.json, so we only exclude heavy/irrelevant paths here.
node_modules
**/node_modules
.git
build
dist
coverage
*.log
firebase-project
dev-docs
.codesandbox

# nested build output, e.g. packages/excalidraw/{dist,node_modules}
**/build
**/dist
